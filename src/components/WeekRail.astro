---
import { experiments } from '../data/labData';
import { weekHref } from '../lib/paths';
import { recordExists } from '../lib/records';

interface Props {
  current: number;
  /** `sidebar` sits beside the article on large screens; `strip` lies across
      the top on small ones. Both are the same rail, rotated. */
  variant: 'sidebar' | 'strip';
}

const { current, variant } = Astro.props;

const nodes = experiments.map((e) => ({
  week: e.week,
  title: e.title,
  bound: recordExists(e.pdf),
}));

const state = (week: number, bound: boolean) =>
  week === current ? 'current' : bound ? 'filled' : 'empty';
---

{
  variant === 'sidebar' ? (
    <nav class="no-print hidden lg:block w-[4.5rem] shrink-0" aria-label="All weeks">
      <div class="sticky top-8">
        <p class="javadoc-mark pl-[0.6rem] mb-2" aria-hidden="true">
          /**
        </p>
        <ol class="list-none m-0 p-0">
          {nodes.map((n) => (
            <li class="grid grid-cols-[1.5rem_1fr] items-center">
              <div class="rail-cell flex justify-center py-2">
                <span class="rail-node" data-state={state(n.week, n.bound)} />
              </div>
              <a
                href={weekHref(n.week)}
                class={`font-mono text-sm py-2 pl-1 hover:text-keyword ${
                  n.week === current ? 'text-keyword font-semibold' : 'text-muted'
                }`}
                aria-current={n.week === current ? 'page' : undefined}
                aria-label={`Week ${String(n.week).padStart(2, '0')}: ${n.title}`}
              >
                {String(n.week).padStart(2, '0')}
              </a>
            </li>
          ))}
        </ol>
        <p class="javadoc-mark pl-[0.6rem] mt-2" aria-hidden="true">
          */
        </p>
      </div>
    </nav>
  ) : (
    <nav class="no-print lg:hidden mb-8" aria-label="All weeks">
      <ol class="list-none m-0 p-0 flex items-stretch gap-1.5">
        {nodes.map((n) => (
          <li class="flex-1 min-w-0">
            <a
              href={weekHref(n.week)}
              class="block py-1"
              aria-current={n.week === current ? 'page' : undefined}
              aria-label={`Week ${String(n.week).padStart(2, '0')}: ${n.title}`}
            >
              <span
                class={`block h-[3px] rounded-full ${
                  n.week === current ? 'bg-keyword' : n.bound ? 'bg-string' : 'bg-rule'
                }`}
              />
              <span
                class={`mt-1.5 block font-mono text-[0.6875rem] text-center ${
                  n.week === current ? 'text-keyword font-semibold' : 'text-muted'
                }`}
              >
                {String(n.week).padStart(2, '0')}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
