---
import type { Experiment } from '../data/labData';
import { weekHref } from '../lib/paths';

interface Props {
  experiment: Experiment;
  bound: boolean;
  index: number;
}

const { experiment, bound, index } = Astro.props;
const n = String(experiment.week).padStart(2, '0');
// Stagger the reveal so the list settles in order, like courses of stone.
const delay = `${Math.min(index, 5) * 60}ms`;
---

<li
  class="week-row"
  data-week={experiment.week}
  data-title={experiment.title.toLowerCase()}
  data-concepts={experiment.concepts.join(' ').toLowerCase()}
  data-aim={experiment.aim.toLowerCase()}
>
  <div data-reveal style={`transition-delay:${delay}`}>
    <a href={weekHref(experiment.week)} class="week-card group px-5 py-5 sm:px-7 sm:py-6">
      <div class="flex items-baseline gap-4">
        <span class="font-display text-lg sm:text-h2 font-semibold leading-none text-accent shrink-0">
          {n}
        </span>
        <h2 class="font-serif font-semibold text-lg sm:text-h2 leading-snug group-hover:text-accent">
          {experiment.title}
        </h2>
      </div>
      <p class="mt-2.5 text-base text-muted line-clamp-2 max-w-measure">
        {experiment.aim}
      </p>
      {!bound && <p class="inscription mt-3">Record not uploaded yet</p>}
    </a>
  </div>
</li>
