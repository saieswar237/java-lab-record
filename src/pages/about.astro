---
import Base from '../layouts/Base.astro';
import { experiments, labInfo, totalWeeks } from '../data/labData';
import { recordExists } from '../lib/records';
import { weekHref } from '../lib/paths';

const rows = experiments.map((e) => ({ ...e, bound: recordExists(e.pdf) }));
const totalPages = rows.reduce((sum, r) => sum + (r.bound ? (r.pages ?? 0) : 0), 0);

const details = [
  { label: 'Institution', value: labInfo.institution },
  { label: 'Laboratory', value: labInfo.labName },
  { label: 'Course code', value: labInfo.courseCode },
  { label: 'Instructor', value: `${labInfo.instructor} Sir` },
  { label: 'Student', value: labInfo.student },
  { label: 'Roll number', value: labInfo.rollNumber },
  { label: 'Experiments', value: `${totalWeeks} (Week 1 – Week ${totalWeeks})` },
];

const description = `Course, instructor and institution details for the ${labInfo.labName} record (${labInfo.courseCode}) of ${labInfo.student}, roll number ${labInfo.rollNumber}.`;
---

<Base title="About this record" description={description}>
  <div class="mx-auto w-full max-w-[76rem] px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-8">
    <div class="print-header">
      <p class="font-mono text-sm">
        {labInfo.institution} · {labInfo.labName} · {labInfo.courseCode}
      </p>
      <p class="font-mono text-sm">
        {labInfo.student} · {labInfo.rollNumber} · Instructor: {labInfo.instructor} Sir
      </p>
    </div>

    <p class="inscription">Colophon</p>
    <h1 class="mt-4 font-display font-semibold text-[1.875rem] sm:text-display-l leading-[1.2] tracking-[0.03em]">
      About this record
    </h1>

    <div class="mt-14 grid gap-16 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <section aria-labelledby="details-heading" data-reveal>
        <h2 id="details-heading" class="inscription border-b border-rule pb-3">Details</h2>
        <dl class="mt-5 grid grid-cols-[8.5rem_minmax(0,1fr)] gap-x-4 gap-y-3 m-0">
          {
            details.map((d) => (
              <>
                <dt class="inscription pt-1">{d.label}</dt>
                <dd class="m-0 font-serif text-base">{d.value}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <div class="min-w-0">
        <section aria-labelledby="organised-heading" data-reveal>
          <h2 id="organised-heading" class="inscription border-b border-rule pb-3">
            How the record is organised
          </h2>
          <p class="mt-5 max-w-measure text-base">
            The lab runs across {totalWeeks} weeks. Each week has one page here,
            carrying the aim of the experiment, the concepts it covers, and the
            scanned record itself embedded in full. Weeks are numbered in the
            order they were performed, so the set reads as a sequence rather than
            a collection — which is why the eight columns on the landing page are
            ordered rather than arranged.
          </p>
          <p class="mt-5 max-w-measure text-base">
            The records were bound from a single submitted document and split
            back into {totalWeeks} files, {totalPages} pages in total. Where an
            experiment begins partway down a page, that page appears in both of
            the weeks it belongs to rather than being cut in half.
          </p>
        </section>

        <section class="mt-14" aria-labelledby="contents-heading" data-reveal>
          <h2 id="contents-heading" class="inscription border-b border-rule pb-3">
            Contents
          </h2>
          <ol class="list-none m-0 p-0 mt-4">
            {
              rows.map((r) => (
                <li class="grid grid-cols-[2.75rem_minmax(0,1fr)_auto] gap-4 items-baseline py-3 border-b border-rule">
                  <span class="font-display font-semibold text-base text-accent">
                    {String(r.week).padStart(2, '0')}
                  </span>
                  <a href={weekHref(r.week)} class="font-serif text-base hover:text-accent">
                    {r.title}
                  </a>
                  <span class="inscription whitespace-nowrap">
                    {r.bound ? `${r.pages ?? '—'} pp` : 'not uploaded'}
                  </span>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="mt-14" aria-labelledby="reading-heading" data-reveal>
          <h2 id="reading-heading" class="inscription border-b border-rule pb-3">
            Reading the records
          </h2>
          <p class="mt-5 max-w-measure text-base">
            On a desktop browser each record is embedded in its week page and can
            be read without leaving the site. On phones and tablets, where
            browsers commonly refuse to display a framed PDF, the page offers the
            file to open or download instead. Every record can be downloaded from
            its own page.
          </p>
        </section>

        <section class="mt-14" aria-labelledby="colophon-heading" data-reveal>
          <h2 id="colophon-heading" class="inscription border-b border-rule pb-3">
            Colophon
          </h2>
          <p class="mt-5 max-w-measure text-base">
            Built as a static site with Astro and Tailwind CSS, and served from
            GitHub Pages. Set in Cinzel, cut from Roman inscriptional capitals,
            with EB Garamond for reading and IBM Plex Mono for code — all
            self-hosted. The site makes no network requests to anything outside
            itself.
          </p>
        </section>
      </div>
    </div>
  </div>
</Base>
