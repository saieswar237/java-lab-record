---
import Base from '../layouts/Base.astro';
import WeekCard from '../components/WeekCard.astro';
import Facade from '../components/Facade.astro';
import { experiments, labInfo, totalWeeks } from '../data/labData';
import { recordExists } from '../lib/records';

const rows = experiments.map((e) => ({ experiment: e, bound: recordExists(e.pdf) }));
const boundCount = rows.filter((r) => r.bound).length;

const identity = [
  { label: 'Student', value: labInfo.student },
  { label: 'Roll number', value: labInfo.rollNumber },
  { label: 'Institution', value: labInfo.institution },
  { label: 'Instructor', value: `${labInfo.instructor} Sir` },
];

const description = `${labInfo.labName} (${labInfo.courseCode}) record of ${totalWeeks} weekly experiments by ${labInfo.student}, roll number ${labInfo.rollNumber}, ${labInfo.institution}.`;
---

<Base title={`${labInfo.labName} Record`} description={description}>
  <div class="mx-auto w-full max-w-[76rem] px-4 sm:px-6 lg:px-8">
    <div class="print-header">
      <p class="font-mono text-sm">
        {labInfo.institution} · {labInfo.labName} · {labInfo.courseCode}
      </p>
      <p class="font-mono text-sm">
        {labInfo.student} · {labInfo.rollNumber} · Instructor: {labInfo.instructor} Sir
      </p>
    </div>

    {/* --- The dedication ------------------------------------------------ */}
    <header class="pt-12 sm:pt-20 max-w-[54rem]">
      <p class="inscription">Record of practical work</p>

      <h1 class="mt-4 font-display font-semibold text-[2.5rem] sm:text-display-xl leading-[1.1] tracking-[0.04em]">
        {labInfo.labName}
      </h1>

      <p class="inscription mt-4 text-accent">{labInfo.courseCode}</p>

      <dl class="mt-10 grid grid-cols-[7.5rem_minmax(0,1fr)] sm:grid-cols-[9.5rem_minmax(0,1fr)] gap-x-5 gap-y-3 pt-8 border-t border-rule m-0">
        {
          identity.map((row) => (
            <>
              <dt class="inscription pt-1">{row.label}</dt>
              <dd class="font-serif text-base text-ink m-0">{row.value}</dd>
            </>
          ))
        }
      </dl>
    </header>

    {/* --- The facade: eight columns, one per week ----------------------- */}
    <section class="mt-16 max-w-[44rem]" aria-labelledby="facade-heading">
      <h2 id="facade-heading" class="sr-only">The eight experiments at a glance</h2>
      <Facade height="7rem" animate />
    </section>

    <p class="mt-12 max-w-measure text-base text-muted">
      Eight weekly experiments, performed, recorded and bound. Each column above
      stands for one week; each opens to its own page with the record embedded
      in full.
    </p>

    {/* --- Filter -------------------------------------------------------- */}
    <div class="no-print max-w-[54rem] mt-14 flex flex-wrap items-end justify-between gap-4 border-t border-rule pt-8">
      <div class="w-full sm:w-auto sm:min-w-[22rem]">
        <label for="week-search" class="inscription block mb-3">Filter experiments</label>
        <input
          id="week-search"
          type="search"
          autocomplete="off"
          placeholder="Search by title or keyword"
          class="w-full bg-surface border border-rule px-3.5 py-3 font-serif text-base text-ink placeholder:text-muted"
        />
      </div>
      <p class="inscription" id="week-count" aria-live="polite">
        {boundCount} of {totalWeeks} records bound
      </p>
    </div>

    <section class="mt-8 pb-4 max-w-[54rem]" aria-label="Weekly experiments">
      <ol class="list-none m-0 p-0 flex flex-col gap-4" id="week-list">
        {
          rows.map((row, i) => (
            <WeekCard experiment={row.experiment} bound={row.bound} index={i} />
          ))
        }
      </ol>

      <p class="hidden mt-8 text-base text-muted" id="week-empty">
        No experiment matches that search. Clear the box to see all {totalWeeks}.
      </p>
    </section>
  </div>
</Base>

<script>
  const input = document.getElementById('week-search') as HTMLInputElement | null;
  const list = document.getElementById('week-list');
  const count = document.getElementById('week-count');
  const empty = document.getElementById('week-empty');

  if (input && list && count && empty) {
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('.week-row'));
    const total = rows.length;
    const initial = count.textContent ?? '';

    const filter = () => {
      const q = input.value.trim().toLowerCase();

      if (!q) {
        rows.forEach((r) => r.classList.remove('hidden'));
        count.textContent = initial;
        empty.classList.add('hidden');
        return;
      }

      let shown = 0;
      for (const row of rows) {
        const hay = [
          row.dataset.title ?? '',
          row.dataset.concepts ?? '',
          row.dataset.aim ?? '',
          `week ${row.dataset.week ?? ''}`,
        ].join(' ');
        const match = hay.includes(q);
        row.classList.toggle('hidden', !match);
        if (match) shown++;
      }

      count.textContent = `${shown} of ${total} shown`;
      empty.classList.toggle('hidden', shown > 0);
    };

    input.addEventListener('input', filter);
    // A restored value after a back-navigation should still filter.
    if (input.value) filter();
  }
</script>
